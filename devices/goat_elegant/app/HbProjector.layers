# Recipe of the Z9X HB projector app, read by tools/devices/assemble_app.py.
# The one projector app: the core with the features of the HB stock, the XGIMI
# gmpf types and the HB family adapter aidl-gmpf, this model's data, and the HB manifest as the core manifest plus
# its patch (devices/goat_elegant/app/HbProjector.manifest.diff). No legacy layer: apps/HbProjector is gone.
app       HbProjector
base      apps/common/projector apps/common/projector/FILES
base      apps/LumenProjector/core
# the XGIMI gmpf value types of the vendor layer and the HB family adapter aidl-gmpf (the design notes:
# the AIDL transport, clients, codes, rules and the menu adapter HbMenuFeatures with its rows)
base      apps/LumenProjector/vendor/xgimi/gmpf
base      apps/LumenProjector/vendor/xgimi/aidl-gmpf
# the shared texts (apps/core/lumen-common-strings): every text two places show, once
module    lumen-common-strings
# the shared projector menu of every Lumen projector with the HB profile; the
# HB adapters are aidl-gmpf panel/HbMenuFeatures (+ HbMenuGates) and the game menu io
module    lumen-system
# the wall colour adaptation (apps/core/lumen-wallcolor): the stock card, pattern and result bar, this model's data
module    lumen-wallcolor
file      devices/goat_elegant/wallcolor.conf assets/lumen_wallcolor/model.conf
module    lumen-aipq
module    lumen-hdmi
# the Lumen icon set (apps/core/lumen-icons): row marks, key hints, its R class named in R_EXTRA_PACKAGES
module    lumen-icons
# problem reports (apps/core/lumen-report): the screen of the General row, automatic reports, the queue
module    lumen-report
# all files access for Lumen Play signed with its release key (apps/core/lumen-files-access)
module    lumen-files-access
# Settings > About: model code, XGIMI firmware, Back to the XGIMI system (apps/core/lumen-about, its QR code lumen-qr)
module    lumen-qr
module    lumen-about
# Parental controls page of the menu: the state of Lumen Home through its provider (apps/core/lumen-parental)
module    lumen-parental
# the remote pairing of every Lumen projector (apps/core/lumen-remote README: remote table, RemotePairing, prompt)
module    lumen-remote
# the signal panel of every projector (apps/core/lumen-signal): the small card and the full panel, this
# model's rows as data
module    lumen-signal
file      devices/goat_elegant/signal.tsv assets/lumen_signal/items.tsv
module    lumen-sensors
file      devices/goat_elegant/sensors.tsv assets/lumen_sensors/items.tsv
module    lumen-ui
# the one HDMI port state (org.lumen.tvinput PortState) for the menu HDMI page and the Source key
module    lumen-hdmiports
module    lumen-source
file      devices/goat_elegant/source.tsv assets/lumen_source/source.tsv
module    lumen-menu
# the HDMI-CEC page of every projector (apps/core/lumen-cec), driven by this app's CecPolicyDriver
module    lumen-cec
# the stock HDMI-CEC defaults of every model (devices/_image/cec_defaults.tsv) for lumen-cec CecDefaults
file      devices/_image/cec_defaults.tsv assets/lumen_cec/defaults.tsv
menu      devices/goat_elegant/menu.json assets/lumen_menu/menu.json
file      devices/goat_elegant/audio/chip_volume.tsv assets/lumen_audio/chip_volume.tsv
# the unit's model code for the family adapter (core UnitModel reads the vendor's model_prop) and the model rows of
# the feature table (aidl-gmpf HbFeatures): which model codes the menu was checked against, what each one hides
file      devices/_vendor/xgimi/vendor.conf assets/lumen_vendor/vendor.conf
file      devices/goat_elegant/hal/model_features.tsv assets/lumen_hal/model_features.tsv
# the shared gmpf clients (GmpfBase / Gmpf2Base and their call layer); the HB clients, its AIDL transport, its codes
# and rules are aidl-gmpf hal/ (GmpfClient, Gmpf2Client, AidlWire, HbCodes, HbRules)
module    lumen-gmpf
# the one raw Binder path of every AIDL family (apps/core/lumen-hal AidlTransport): AidlWire is the HB subclass
module    lumen-hal
# the shared media route rules (apps/core/lumen-audio: MediaPath, ArcAside)
module    lumen-audio
# the command core and the stock XGIMI phone remote (apps/core/lumen-control; it reads the device through lumen-stats)
module    lumen-stats
module    lumen-control
# the optional parts of the core this model's stock has (apps/LumenProjector/core.features): the AIDL gmpf line's own
# pages and rules, none of the Z9X ones (no quick 3D, its own refusal rules, no audio port callbacks, no keystone restore)
feature   curtain-align output-options boost-rules color-space-rule slide-coalescing zoom-tile sleep-timer-card
feature   home-tiles-aidl menu-pages-aidl stock-labels-aidl
# the HB manifest: sharedUserId system, direct boot, the HB receivers and provider (assemble_app.py rule 10)
patch     devices/goat_elegant/app/HbProjector.manifest.diff
# never part of an app tree: build output, APKs, notes
skip      build/ *.apk CHANGES*.md README*.md SYNCED.txt .DS_Store
