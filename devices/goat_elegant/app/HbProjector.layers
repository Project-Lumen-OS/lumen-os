# Recipe of the Z9X HB projector app, read by tools/devices/assemble_app.py.
# The HB app is the Z9X app minus the Z9X-only files below, plus the HB layer (apps/HbProjector: the real forks,
# each with a row in devices/goat_elegant/forks.tsv, and the HB-only files). The Z9X folder is only read.
app       HbProjector
base      apps/Z9xProjector
# the shared projector menu of every Lumen projector with the HB profile; the
# HB adapters are apps/HbProjector panel/HbMenuFeatures (+ HbMenuGates) and the game menu io
module    lumen-menu
file      devices/goat_elegant/menu.json assets/lumen_menu/menu.json
# the shared gmpf clients (GmpfBase / Gmpf2Base and their call layer); the HB clients, its AIDL transport, its codes
# and rules are apps/HbProjector hal/ (GmpfClient, Gmpf2Client, AidlWire, HbCodes, HbRules)
module    lumen-gmpf
# the Z9X quick panel controller: on the HB QuickPanel drives the shared MenuController through the HB-only
# panel/QuickPanelController (HbMenu); the old HB fork of the Z9X controller and the HB game bar are gone
drop      src/org/lumen/projector/panel/QuickPanelController.java
# Z9X-only: the report screen, 3D, the Z9X fit adapter, the HIDL transport and focus callback (the HB is AIDL), the Z9X
# gmpf codes and rules, the 1.0.8 import
drop      src/org/lumen/projector/report/
drop      src/org/lumen/projector/display/ThreeD.java
drop      src/org/lumen/projector/fit/Z9xFitDevice.java
drop      src/org/lumen/projector/hal/Hidl*.java
drop      src/org/lumen/projector/hal/Z9x*.java
# the Z9X HIDL code table; the HB has its own HalCodes (devices/goat_elegant/hal/codes.tsv)
drop      src/org/lumen/projector/hal/HalCodes.java
drop      src/org/lumen/common/LumenImport.java
# Z9X-only strings of the keystone page's last section (the HB has its own, strings_hb.xml)
drop      res/values*/strings_kst_restore.xml
# Z9X-only 1.0.8 rules: the HB quick panel and keystone page are its own forks with their own colour temperature,
# 3D and game rules, so these classes and their host tests are not part of the HB app
drop      src/org/lumen/projector/panel/ColorTempRule.java
drop      src/org/lumen/projector/panel/Lamp3d.java
drop      src/org/lumen/projector/panel/KstGameLock.java
drop      test/picture/
drop      test/kstgame/
drop      test/lamp3d/
# Z9X-only 2026-11-04 sweep: the stock Z9X refusal rules (they use KstGameLock / Lamp3d), the AI scene policy and
# their notes; the HB quick panel, keystone screens and App are its own forks
drop      src/org/lumen/projector/panel/PanelRules.java
drop      src/org/lumen/projector/panel/RefusalReason.java
drop      src/org/lumen/projector/panel/RuleNotes.java
drop      src/org/lumen/projector/AiScenePolicy.java
drop      res/values*/strings_rules.xml
drop      test/rules/
# Z9X quick panel layout D (2026-11-11): its device-only part (the Input popup over the Z9X HAL); the shared menu
# itself is the lumen-menu module above; the HB drives it through panel/HbMenu (no fork of it)
drop      src/org/lumen/projector/panel/QpdSource.java
# Z9X menu adapters (Z9X HAL): every device brings its own
drop      src/org/lumen/projector/panel/Z9x*.java
drop      src/org/lumen/projector/utils/Z9x*.java
# Z9X game try fixes (2026-11-11): audio device callbacks behind the audio policy check with the trial notice, the
# Sound page state in the stock mapping; Z9X only (the HB keeps its forks of AudioPathReporter, AudioOutputChoice
# and App; its quick panel is the shared menu)
drop      src/org/lumen/projector/audio/AudioPorts.java
drop      src/org/lumen/projector/audio/AudioPortRules.java
drop      res/values*/strings_trial.xml
# Lumen OS installer, final install (2026-11-11): the Z9X KeyReceiver ignores every global key while it writes; Z9X
# only (the HB keeps its own KeyReceiver fork)
drop      src/org/lumen/projector/sys/InstallGuard.java
drop      test/install/
# Z9X-only: the render parity of the Z9X quick menu against the Z9X 1.0.10 panel (its ROOT is the repo, not this tree)
drop      test/render/
top       apps/HbProjector
# never part of an app tree: build output, APKs, notes
skip      build/ *.apk CHANGES*.md README*.md SYNCED.txt .DS_Store
