# GENERATED by tools/devices/model_props.py rc from hb_model_props.tsv: do not edit by hand.
# The stock model properties. The stock XGIMI init loads /vendor/etc/xgimimodelname/<model>/build.prop at every boot,
# LineageOS init does not. Each block below sets the lines of one stock file at early-init, before the vendor HWC and
# every other service starts, only on the model and vendor firmware whose file it is. Init builtins only; the vendor
# is not changed.
# One HB image serves G0130, G0148 and G0118 on two vendor firmwares, and G0118's file differs between them. Among
# the lines: vendor.mstar.hwc.framebuffer.format (vendor hwcomposer), ro.xgimi.mem.policy (vendor init.fusion.rc
# memory watermark), persist.vendor.xgimi.hd_server (the human detection server of the eye protection),
# ro.xgimi.default.aipq (the default AI scene).

# G0130 on v6.16.24: hb_model_prop_dapengse.txt (stock sha256 931b67bba055b3be438c0da71706c5625891e01bc7d2c4199f0c5c3b403f2cb4)
on early-init && property:ro.boot.xgimi.modelname=G0130 && property:ro.vendor.build.version.incremental=v6.16.24
    setprop ro.xgimi.product.name Product_dapengse
    setprop persist.vendor.xgimi.hd_server 2
    setprop ro.xgimi.fun.hidesystemapp com.yunos.tv.alitvasr
    setprop persist.xgimi.wifidongle.check enable
    setprop vendor.xgimi.softap.sta.coexist true
    setprop vendor.xgimi.disable.subwoofer 1
    setprop ro.xgimi.line.cast 0
    setprop xgimi.image4k.support 1
    setprop tv.series.model Product_dapengse
    setprop persist.xgimi.gmui.font.bold Medium
    setprop vendor.mstar.hwc.framebuffer.format 1
    setprop persist.vendor.xgimi.animation.style blue
    setprop persist.xgimi.bootanimation.style blue
    setprop ro.xgimi.default.aipq film
    setprop log.tag.ANNPreparedModelBase S
    setprop log.tag.ANNExecutor S
    setprop ro.product.unique XGIMI+MT9660+M-UHD003F000300030001000000010001+dapengse+ProjectorUHD_3
    setprop persist.vendor.xgimi.enforce.volume 25
    setprop vendor.mstar.trapezoid.secure.enable 1
    setprop vendor.xgimi.disable_decorview_anti_aliasing true
    setprop ro.xgimi.stability.kernel.enabled 0
    setprop ro.xgimi.mem.policy 2G
    setprop vendor.xgimi.bootanim.delay 9000

