# Recipe of X50Projector (the X50 projector menu), read by tools/devices/assemble_app.py and tools/devices/build_apps.sh: the
# shared lumen-ui module (TvFocus, Tokens), lumen-menu (the shared projector menu) with this model's
# profile as assets/lumen_menu/menu.json, plus the app. The module is closed: no file of apps/X50Projector may shadow it.
app       X50Projector
module    lumen-ui
module    lumen-source
file      devices/g0111/source.tsv assets/lumen_source/source.tsv
module    lumen-hal
module    lumen-common-strings
module    lumen-system
# the wall colour adaptation (apps/core/lumen-wallcolor): the stock card, pattern and result bar, this model's data
module    lumen-wallcolor
file      devices/g0111/wallcolor.conf assets/lumen_wallcolor/model.conf
module    lumen-aipq
module    lumen-hdmi
# the Lumen icon set (apps/core/lumen-icons): row marks, key hints, its R class named in R_EXTRA_PACKAGES
module    lumen-icons
# problem reports (apps/core/lumen-report): the screen of the General row, automatic reports, the queue
module    lumen-report
# all files access for Lumen Play signed with its release key (apps/core/lumen-files-access)
module    lumen-files-access
# Settings > About: model code, XGIMI firmware, Back to the XGIMI system (apps/core/lumen-about, its QR code lumen-qr)
module    lumen-qr
module    lumen-about
# the remote pairing of every Lumen projector (apps/core/lumen-remote README: remote table, RemotePairing, prompt)
module    lumen-remote
# the signal panel of every projector (apps/core/lumen-signal): the small card and the full panel, this
# model's rows as data
module    lumen-signal
file      devices/g0111/signal.tsv assets/lumen_signal/items.tsv
module    lumen-sensors
file      devices/g0111/sensors.tsv assets/lumen_sensors/items.tsv
module    lumen-menu
# the HDMI-CEC page of every projector (apps/core/lumen-cec), the stock X50 rows of the driver X50Cec
module    lumen-cec
# the stock HDMI-CEC defaults of every model (devices/_image/cec_defaults.tsv) for lumen-cec CecDefaults
file      devices/_image/cec_defaults.tsv assets/lumen_cec/defaults.tsv
module    lumen-stats
# the shared media route rules (apps/core/lumen-audio: MediaPath, ArcAside)
module    lumen-audio
# the command core and the stock XGIMI phone remote (apps/core/lumen-control; it reads the device through lumen-stats)
module    lumen-control
base      apps/common/projector devices/g0111/app/X50Projector.projector
file      devices/g0111/menu.json assets/lumen_menu/menu.json
file      devices/g0111/audio/chip_volume.tsv assets/lumen_audio/chip_volume.tsv
top       apps/X50Projector
skip      build/ *.apk CHANGES*.md README*.md DESIGN*.md .DS_Store app.layers BUILD_VERSION
