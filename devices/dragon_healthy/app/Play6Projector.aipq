# The stock AI picture quality on the Play 6 (org.lumen.aipq.AiPq): the one glue file of the gmpf projectors, taken
# from the Z9X app as is (its Hal is the Play 6 Hal, its client the shared GmpfBase of Play6Gmpf).
src/org/lumen/projector/AiScenePolicy.java
# the core files the Play 6 shares with the one projector app (not copies): AudioOutputKind, the output kinds of the
# sound output rows
src/org/lumen/projector/audio/AudioOutputKind.java
# the eye protection mask icon (a copy in apps/Play6Projector until step 3b)
res/drawable/ic_eye_mask.xml
# the core classes folded for the Play 6 (step 3b part 3): what differs per family is the play6-hidl Family (log tag and
# thread prefix, the assistant's keystone and low power, the manual focus HAL checks and motor)
src/org/lumen/projector/voice/AssistantHost.java
src/org/lumen/projector/source/BootSource.java
src/org/lumen/projector/ManualFocusActivity.java
# the core classes folded for the Play 6 (step 3b part 4): what differs is the play6-hidl Family (the eye mask without
# the vendor UI watchdog, the timer fade without the lamp step, the keys' power, focus, shortcut and screensaver
# rules, the sound output without the digital format)
src/org/lumen/projector/eye/EyeGuard.java
src/org/lumen/projector/power/SleepTimer.java
# the power key's short press and hold over the user's setting (the same class as the gmpf PowerKey)
