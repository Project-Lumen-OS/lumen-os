+    /**
+     * The V3 calls this P2P interface really has, from its interface hash (see SupplicantP2pV3Calls): a supplicant
+     * that reports V3 from a snapshot taken before V3 froze gets the V2 calls.
+     */
+    private SupplicantP2pV3Calls v3CallsOf(@NonNull ISupplicantP2pIface iface) {
+        int version = getCachedServiceVersion();
+        String hash = null;
+        if (version >= 3) {
+            try {
+                hash = iface.getInterfaceHash();
+            } catch (RemoteException e) {
+                Log.e(TAG, "getInterfaceHash failed, using the V2 calls", e);
+            }
+        }
+        SupplicantP2pV3Calls calls = SupplicantP2pV3Calls.of(version, hash);
+        Log.i(TAG, "Supplicant P2P interface: " + calls);
+        return calls;
     }
 
