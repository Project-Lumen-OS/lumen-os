+package com.android.server.wifi.p2p;
+
+import java.util.Set;
+import java.util.TreeSet;
+
+/**
+ * The AIDL V3 calls of ISupplicantP2pIface that may go to the running supplicant, decided per call from the
+ * interface hash it reports, never from its version number alone.
+ *
+ * A V3 call goes out only when the hash is the frozen V3 one. A supplicant that answers version 3 with another hash
+ * was built from a snapshot taken before V3 froze. The MediaTek TV vendors (hash 4652398b...) keep the 63 V2 calls at
+ * their frozen transaction codes, put a vendor call at code 64, where frozen V3 has connectWithParams, and have
+ * nothing above it: connectWithParams would run that vendor call and every other V3 call fails as unimplemented,
+ * which drops the P2P interface. Such a supplicant gets the V2 calls. A V3 call that still answers unimplemented is
+ * not sent again while the interface lives.
+ */
+public final class SupplicantP2pV3Calls {
+    public static final String CONNECT = "connectWithParams";
+    public static final String FIND = "findWithParams";
+    public static final String EXT_LISTEN = "configureExtListenWithParams";
+
+    /** hardware/interfaces/wifi/supplicant/aidl/aidl_api/android.hardware.wifi.supplicant/3/.hash */
+    public static final String FROZEN_V3_HASH = "55b58c9bd6d40c1459073b5d03f4ede5cfc9a212";
+
+    private static final String UNIMPLEMENTED_PREFIX = "Method ";
+    private static final String UNIMPLEMENTED_SUFFIX = " is unimplemented.";
+
+    private final Set<String> mCalls = new TreeSet<>();
+    private final String mWhy;
+
+    private SupplicantP2pV3Calls(boolean frozenV3, String why) {
+        if (frozenV3) {
+            mCalls.add(CONNECT);
+            mCalls.add(FIND);
+            mCalls.add(EXT_LISTEN);
+        }
+        mWhy = why;
+    }
+
+    /** No V3 call: before the P2P interface is set up. */
+    public static SupplicantP2pV3Calls none() {
+        return new SupplicantP2pV3Calls(false, "no interface");
+    }
+
+    /** The calls for a supplicant that reports this AIDL version and interface hash (null if unknown). */
+    public static SupplicantP2pV3Calls of(int version, String hash) {
+        if (version < 3) {
+            return new SupplicantP2pV3Calls(false, "V" + version);
+        }
+        boolean frozen = FROZEN_V3_HASH.equals(hash);
+        return new SupplicantP2pV3Calls(frozen,
+                "V" + version + " hash " + hash + (frozen ? " (frozen V3)" : " (not the frozen V3, V2 calls)"));
+    }
+
+    /** True if the V3 call may be sent. */
+    public boolean has(String call) {
+        return mCalls.contains(call);
+    }
+
+    /**
+     * After a RemoteException of a V3 call: true if the proxy said the supplicant does not implement it. The call is
+     * then off for the life of the interface and the caller uses the V2 call instead of dropping the interface.
+     */
+    public boolean dropIfUnimplemented(String call, String exceptionMessage) {
+        if (!isUnimplemented(call, exceptionMessage)) {
+            return false;
+        }
+        mCalls.remove(call);
+        return true;
+    }
+
+    /** The message of the AIDL Java proxy when the remote answers UNKNOWN_TRANSACTION. */
+    static boolean isUnimplemented(String call, String exceptionMessage) {
+        return (UNIMPLEMENTED_PREFIX + call + UNIMPLEMENTED_SUFFIX).equals(exceptionMessage);
+    }
+
+    @Override
+    public String toString() {
+        return mWhy + ", V3 calls " + mCalls;
+    }
+}
