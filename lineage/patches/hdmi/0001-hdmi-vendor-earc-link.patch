+package com.android.server.hdmi;
+
+import android.content.ContentResolver;
+import android.database.ContentObserver;
+import android.media.AudioDeviceAttributes;
+import android.media.AudioDeviceInfo;
+import android.os.Handler;
+import android.os.UserHandle;
+import android.provider.Settings.Global;
+import android.util.Slog;
+
+import com.android.server.hdmi.HdmiAnnotations.ServiceThreadOnly;
+
+/**
+ * A vendor eARC link next to CEC ARC, the way the stock XGIMI frameworks keep it (G0082, G0111, G0130 and G0148
+ * services.jar: AudioService seteARCStatus / geteArcStatus / setCecStatus, HdmiCecLocalDeviceTv
+ * notifyArcStatusToAudioService). These vendors have no Android eARC HAL: the vendor brings the link up by itself and
+ * the projector app reports it (stock: XRMService on the vendor's TV event 11 "eARCstate:1|0" and one read at its
+ * start). Here the app writes {@link #SETTING}; the rules are the stock ones:
+ * <ul>
+ *   <li>the link comes up while CEC ARC is not established: the HDMI ARC output is connected (no name, no
+ *       descriptors); the link ends while CEC ARC is not established: that output is removed;</li>
+ *   <li>CEC ARC ends while the link is up: the HDMI ARC output stays ("don't disconnect ARC while eARC mode").</li>
+ * </ul>
+ * The setting is put back to 0 when this starts (a link of a past boot says nothing), and {@link #GLUE_PROPERTY} tells
+ * the projector app that it no longer connects the output itself. Service thread only.
+ */
+final class VendorEarc {
+    private static final String TAG = "HdmiVendorEarc";
+    /** Settings.Global, written by the projector app: 1 = the vendor's eARC link is up. */
+    static final String SETTING = "lumen_vendor_earc";
+    /** "1" while this code runs (the projector app leaves the HDMI ARC output to the framework). */
+    static final String GLUE_PROPERTY = "sys.lumen.vendor_earc_glue";
+
+    private static VendorEarc sInstance;
+
+    private final HdmiControlService mService;
+    /** Stock AudioService.meARCStatus. */
+    private boolean mLinked;
+    /** Stock AudioService.mARCStatus (HdmiCecLocalDeviceTv.setCecStatus). */
+    private boolean mCecArc;
+
+    private VendorEarc(HdmiControlService service) {
+        mService = service;
+    }
+
+    @ServiceThreadOnly
+    static VendorEarc get(HdmiControlService service) {
+        if (sInstance == null) {
+            sInstance = new VendorEarc(service);
+            sInstance.start();
+        }
+        return sInstance;
+    }
+
+    private void start() {
+        try {
+            ContentResolver cr = mService.getContext().getContentResolver();
+            Global.putInt(cr, SETTING, 0);
+            cr.registerContentObserver(Global.getUriFor(SETTING), false,
+                    new ContentObserver(new Handler(mService.getServiceLooper())) {
+                        @Override
+                        public void onChange(boolean selfChange) {
+                            onSetting();
+                        }
+                    }, UserHandle.USER_ALL);
+            mService.writeStringSystemProperty(GLUE_PROPERTY, "1");
+        } catch (RuntimeException e) {
+            Slog.w(TAG, "vendor eARC link not followed: " + e);
+        }
+    }
+
+    @ServiceThreadOnly
+    private void onSetting() {
+        boolean linked = Global.getInt(mService.getContext().getContentResolver(), SETTING, 0) == 1;
+        if (linked == mLinked) return;
+        mLinked = linked;
+        Slog.d(TAG, "meARC Status: " + linked);
+        if (mCecArc) return;
+        AudioManagerWrapper audio = mService.getAudioManager();
+        if (audio == null) return;
+        audio.setWiredDeviceConnectionState(new AudioDeviceAttributes(AudioDeviceAttributes.ROLE_OUTPUT,
+                AudioDeviceInfo.TYPE_HDMI_ARC, ""), linked ? 1 : 0);
+    }
+
+    /** Stock geteArcStatus: the vendor's eARC link is up. */
+    boolean linked() {
+        return mLinked;
+    }
+
+    /** Stock setCecStatus: CEC ARC is established (true) or not. */
+    void setCecArc(boolean established) {
+        mCecArc = established;
+        Slog.d(TAG, "mARC Status: " + established);
+    }
+}
