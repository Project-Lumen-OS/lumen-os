<?xml version="1.0" encoding="utf-8"?>
<!--
  org.lumen.home "Lumen Home": the Google TV style launcher of Lumen OS (author kmuradoff).
  Install: /system/priv-app/Z9xHome/Z9xHome.apk, platform-signed (release platform key after sign_tar),
  NOT persistent, no sharedUserId. Image files: image/privapp-permissions-z9xhome.xml,
  image/default-permissions-z9xhome.xml, and initial-package-state stopped=false.

  Components marked [launcher] are switched by org.lumen.projector's LauncherSwitcher and are
  disabled in classic mode; .search.SearchActivity, .search.VoiceSearchAlias and .search.MicUpReceiver
  stay enabled (mic key) and cost nothing until used. HOME priority 3: Lumen Setup 10 > Lumen Home 3 >
  tvlauncher 2, so the fallback holder is deterministic.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.lumen.home"
    android:versionCode="110"
    android:versionName="1.0.10">

    <uses-sdk android:minSdkVersion="34" android:targetSdkVersion="34" />

    <!-- Only the projector app (org.lumen.projector; org.lumen.x50.projector on the X50; platform-signed) may start voice
         search and signal the mic release. -->
    <permission android:name="org.lumen.home.permission.MIC" android:protectionLevel="signature" />
    <!-- the parental controls state (ParentalProvider): the projector apps' menu page reads and writes it -->
    <permission android:name="org.lumen.parental.permission.SETTINGS" android:protectionLevel="signature" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- TvProvider -->
    <uses-permission android:name="android.permission.START_ACTIVITIES_FROM_BACKGROUND" />
    <uses-permission android:name="com.android.providers.tv.permission.READ_EPG_DATA" />
    <uses-permission android:name="com.android.providers.tv.permission.WRITE_EPG_DATA" />
    <!-- signature|privileged against TvProvider's own cert: granted only because we are a priv-app -->
    <uses-permission android:name="com.android.providers.tv.permission.ACCESS_ALL_EPG_DATA" />
    <!-- dangerous; only used by the "limited" fallback when the privileged one is missing -->
    <uses-permission android:name="android.permission.READ_TV_LISTINGS" />
    <!-- apps, usage, search providers, CEC names -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />
    <uses-permission android:name="android.permission.GLOBAL_SEARCH" />
    <uses-permission android:name="android.permission.HDMI_CEC" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- network: posters, weather -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- the corner's network mark: the Wi-Fi strength (4PDA 2026-11-22) -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Customize Home, Free up memory (data/MemoryCleaner): the running processes of other apps (REAL_GET_TASKS,
         signature|privileged) and closing their background processes the way Android does (killBackgroundProcesses
         of another package needs FORCE_STOP_PACKAGES since Android 14; nothing is force stopped) -->
    <uses-permission android:name="android.permission.REAL_GET_TASKS" />
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <uses-permission android:name="android.permission.FORCE_STOP_PACKAGES" />
    <!-- voice search client: pre-granted by default-permissions, self-grant fallback (signature) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.GRANT_RUNTIME_PERMISSIONS" />
    <!-- 1.0.1: the living sky as the screensaver default on projectors upgraded from 1.0 (sky/DreamDefault,
         once); signature|privileged, held as a platform-signed priv-app -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <!-- the USB card's size line (data/UsbVolumes, StatFs on the drive); Files (org.lumen.files) does the rest.
         signature|appop|preinstalled, granted by the platform signature -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <!-- Google Play without a Google account (PlayGate): Home reads whether a Google account is there
         (signature|privileged, held as a platform-signed priv-app, privapp-permissions-z9xhome.xml lists it too) -->
    <uses-permission android:name="android.permission.GET_ACCOUNTS_PRIVILEGED" />
    <!-- our other apps (signature permissions they define; the four org.lumen.projector ones are defined by
         org.lumen.x50.projector on the X50 image, proj/ProjectorTarget) -->
    <uses-permission android:name="org.lumen.projector.permission.SHOW_PANEL" />
    <uses-permission android:name="org.lumen.projector.permission.SHOW_SOURCE" />
    <uses-permission android:name="org.lumen.projector.permission.SET_LAUNCHER" />
    <uses-permission android:name="org.lumen.projector.permission.STANDBY_STATE" />
    <uses-permission android:name="org.lumen.tvinput.permission.HDMI_STATE" />
    <uses-permission android:name="org.lumen.updater.permission.OTA_STATE" />

    <queries>
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LEANBACK_LAUNCHER" /></intent>
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent>
        <intent><action android:name="android.intent.action.SEARCH" /></intent>
        <intent><action android:name="android.media.tv.action.INITIALIZE_PROGRAMS" /></intent>
        <intent><action android:name="android.speech.RecognitionService" /></intent>
        <package android:name="com.google.android.youtube.tv" />
        <package android:name="com.google.android.tvlauncher" />
        <package android:name="com.google.android.apps.mediashell" />
        <package android:name="org.lumen.projector" />
        <package android:name="org.lumen.x50.projector" />
        <package android:name="org.lumen.tvinput" />
        <package android:name="org.lumen.airplay" />
        <package android:name="org.lumen.updater" />
    </queries>

    <application
        android:name=".App"
        android:label="@string/app_name"
        android:icon="@drawable/brand_icon_home"
        android:banner="@drawable/brand_banner_home"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:largeHeap="false"
        android:hardwareAccelerated="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Lumen.Home">

        <!-- [launcher] HOME. directBootAware: Android starts it right after the boot animation instead of the system's
             FallbackHome, before the user is unlocked. Only this activity is: the app's providers, receivers and
             other activities come with the unlock, and HomeActivity reads nothing but the saved screen
             (device protected) until then (model/BootGate). -->
        <activity
            android:name=".HomeActivity"
            android:directBootAware="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true"
            android:resumeWhilePausing="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|screenSize|smallestScreenSize|screenLayout|orientation|uiMode|density"
            android:windowSoftInputMode="adjustNothing">
            <intent-filter android:priority="3">
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Customize Home (extra page=backup: its backup page), opened by the projector menu's backup row -->
            <intent-filter>
                <action android:name="org.lumen.home.action.CUSTOMIZE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- [launcher] four-diamond key: PhoneWindowManager.launchAllAppsAction sends ACTION_ALL_APPS to the
             package of the system HOME activity. -->
        <activity-alias
            android:name=".AllAppsAlias"
            android:targetActivity=".HomeActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.ALL_APPS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".customize.CustomizeActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.Lumen.Panel"
            android:configChanges="keyboard|keyboardHidden|navigation|screenSize|smallestScreenSize|screenLayout|orientation|uiMode|density"
            android:windowSoftInputMode="adjustNothing|stateHidden" />

        <!-- Files moved into its own app (org.lumen.files). Once per install it takes the SMB servers saved in the
             old Files panel from here (data/ServersHandOff: only that app, signed with Home's key, may call it) -->
        <provider
            android:name=".data.ServersHandOff"
            android:authorities="org.lumen.home.netservers"
            android:exported="true" />

        <!-- ALWAYS enabled (also in classic mode): search. Listening only via VoiceSearchAlias (MIC perm). -->
        <activity
            android:name=".search.SearchActivity"
            android:exported="true"
            android:taskAffinity="org.lumen.home.search"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.Lumen.Search"
            android:configChanges="keyboard|keyboardHidden|navigation|screenSize|smallestScreenSize|screenLayout|orientation|uiMode|density"
            android:windowSoftInputMode="adjustNothing|stateHidden">
            <intent-filter>
                <action android:name="android.search.action.GLOBAL_SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Katniss is gone (speed spec 3.3): web / voice-web search and SEARCH_LONG_PRESS land on Lumen
                 search too (keyboard entry, SearchManager.QUERY prefilled; never listens) instead of the
                 TvFrameworkPackageStubs "not supported" stub or ActivityNotFoundException -->
            <intent-filter>
                <action android:name="android.speech.action.WEB_SEARCH" />
                <action android:name="android.intent.action.WEB_SEARCH" />
                <action android:name="android.intent.action.SEARCH_LONG_PRESS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity-alias
            android:name=".search.VoiceSearchAlias"
            android:targetActivity=".search.SearchActivity"
            android:exported="true"
            android:permission="org.lumen.home.permission.MIC">
            <intent-filter>
                <action android:name="org.lumen.home.action.VOICE_SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>
        <receiver
            android:name=".search.MicUpReceiver"
            android:exported="true"
            android:permission="org.lumen.home.permission.MIC">
            <intent-filter><action android:name="org.lumen.home.action.MIC_UP" /></intent-filter>
        </receiver>

        <!-- [launcher] TvProvider plumbing that tvrecommendations used to provide -->
        <activity
            android:name=".tvp.BrowsableRequestActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:noHistory="true">
            <intent-filter>
                <action android:name="android.media.tv.action.REQUEST_CHANNEL_BROWSABLE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!-- sent by system_server (TvInputManagerService); the permission keeps ordinary apps from spoofing it -->
        <receiver
            android:name=".tvp.BrowsableRequestReceiver"
            android:exported="true"
            android:permission="android.permission.MODIFY_PARENTAL_CONTROLS">
            <intent-filter><action android:name="android.media.tv.action.CHANNEL_BROWSABLE_REQUESTED" /></intent-filter>
        </receiver>
        <!-- Lumen screensaver: the living landscape (org.lumen.home.sky, scene shared with the Home wallpaper).
             Stays enabled in classic-launcher mode (org.lumen.keep_in_classic: Z9xProjector's LauncherSwitcher
             skips it). The image makes it the framework default dream (Z9xFrameworkKeysOverlay
             config_dreamsDefaultComponent -> Settings.Secure screensaver_default_component on a fresh
             userdata; 1.0.1: sky/DreamDefault does it once on projectors upgraded from 1.0); the active
             choice (screensaver_components) stays with the user / Z9xProjector (DreamDefault replaces it
             only when it names no installed dream). -->
        <service
            android:name=".sky.SkyDreamService"
            android:exported="true"
            android:label="@string/sky_dream_label"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data android:name="org.lumen.keep_in_classic" android:value="true" />
        </service>

        <!-- [launcher] best effort only; the authoritative diff runs at every HomeActivity start -->
        <receiver android:name=".tvp.PackageReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_ADDED" />
                <data android:scheme="package" />
            </intent-filter>
        </receiver>
            <!-- the parental controls (apps/core/lumen-parental): the state for the projector menu's Parental controls
             page (ParentalProvider); the old address of the parent page only redirects to that page -->
        <provider
            android:name="org.lumen.parental.ParentalProvider"
            android:authorities="org.lumen.parental"
            android:exported="true"
            android:permission="org.lumen.parental.permission.SETTINGS" />
        <activity
            android:name="org.lumen.parental.ParentalActivity"
            android:exported="true"
            android:theme="@android:style/Theme.NoDisplay"
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="org.lumen.parental.SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name="org.lumen.parental.PinActivity"
            android:exported="false"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:excludeFromRecents="true" />
        <activity
            android:name="org.lumen.parental.RestActivity"
            android:exported="false"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:launchMode="singleTop"
            android:excludeFromRecents="true" />
        <service
            android:name="org.lumen.parental.UsageService"
            android:exported="false" />
    </application>
</manifest>
