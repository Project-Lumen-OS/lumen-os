# Lumen HDMI receiver bridge (install as /system/etc/init/lumen_hdmirx.rc; script /system/etc/lumen/lumen_hdmirx.sh
# 0755). Shipped only in images whose model lists hdmi_format in devices/<c>/signal.tsv (Z9X, Z9X HB, the X50
# family); the script checks the model code as well.
#
# The signal panel of org.lumen.projector (system uid) sets sys.lumen.hdmirx.req to a new token (the same request
# pattern as sys.z9x.wake_query in z9x_power_cec.rc); this oneshot asks the MStar receiver once and answers in
# sys.lumen.hdmirx.done with the info lines in /dev/lumen_hdmirx/info.txt. A request that comes while one runs is not
# started twice (init: start of a running oneshot does nothing; the app then simply asks again later).
# Labels: the service runs in u:r:su:s0 like every Lumen root helper of these userdebug images (z9x_power_wake,
# z9x_bootinfo, lumen_dsu_install); sys.lumen.* is system_prop (sys.*); /dev/lumen_hdmirx is labelled by init from the plat file contexts.
# The image runs permissive, so the app's read of that directory is not refused.

on boot
    mkdir /dev/lumen_hdmirx 0755 root system

on property:sys.lumen.hdmirx.req=* && property:sys.boot_completed=1
    start lumen_hdmirx

service lumen_hdmirx /system/bin/sh /system/etc/lumen/lumen_hdmirx.sh
    user root
    group root system log
    seclabel u:r:su:s0
    oneshot
    disabled
