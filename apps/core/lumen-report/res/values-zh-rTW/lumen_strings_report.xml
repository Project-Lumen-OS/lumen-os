    <string name="lumen_report_exc_files">相片、檔案和密碼</string>
    <string name="lumen_report_footer">報告保留 30 天，只有 Lumen OS 開發者可以開啟。</string>
    <string name="lumen_report_last">上次報告：%1$s，%2$s</string>
    <string name="lumen_report_send">傳送報告</string>
    <string name="lumen_report_collecting">正在收集資訊…（%1$d/%2$d）</string>
    <string name="lumen_report_log_hint">如果 Android 詢問是否允許存取裝置記錄，請選擇「允許」。</string>
    <string name="lumen_report_sending">正在傳送… %1$s/%2$s</string>
