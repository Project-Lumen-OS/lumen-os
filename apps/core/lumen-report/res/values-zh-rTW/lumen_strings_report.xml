    <string name="lumen_report_err_network">無法連線到報告伺服器，請稍後再試。</string>
    <string name="lumen_report_err_rate">目前報告過多，請稍後再試。</string>
    <string name="lumen_report_err_rejected">報告伺服器未接受這份報告。</string>
    <string name="lumen_report_err_server">報告伺服器發生問題，請稍後再試。</string>
