    <string name="lumen_report_queued_title">報告將稍後傳送</string>
    <string name="lumen_report_queued_text">目前無法連線到報告伺服器。投影機會在可以連線時自動傳送報告，屆時報告代碼會顯示在這裡。</string>
    <string name="lumen_report_last_auto">上次自動報告：%1$s，%2$s</string>
