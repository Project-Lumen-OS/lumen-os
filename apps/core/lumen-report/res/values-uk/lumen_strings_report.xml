    <string name="lumen_report_exc_files">Фото, файли та паролі</string>
    <string name="lumen_report_footer">Звіт зберігається 30 днів. Відкрити його може лише розробник Lumen OS.</string>
    <string name="lumen_report_last">Останній звіт: %1$s, %2$s</string>
    <string name="lumen_report_send">Надіслати звіт</string>
