<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: LicenseRef-PolyForm-Noncommercial-1.0.0
     Buttons and rows of the problem report screen: a cream frame on focus, a faint fill otherwise. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="#33E9CF9C" />
            <stroke android:width="2dp" android:color="#FFE9CF9C" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="#44E9CF9C" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="#14FFFFFF" />
        </shape>
    </item>
</selector>
