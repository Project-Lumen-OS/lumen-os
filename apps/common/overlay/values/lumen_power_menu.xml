<?xml version="1.0" encoding="utf-8"?>
<!-- The Android power menu of every model, declared once (Lineage 21 frameworks/base/core/res/res/values/config.xml
     config_globalActionsList, string-array, translatable="false"; read by LineageGlobalActionsService while
     LineageSettings.Secure power_menu_actions is unset). Android shows it where a family maps the held KEYCODE_POWER to
     the power menu (config_longPressOnPowerBehavior 1: the IR remote, the body key and phone remote apps); the BT remotes'
     power key is KEYCODE_STB_POWER and opens Lumen's own power menu instead. Exactly "power" (power off) and "restart",
     as the Z9X has had since 2026-10-04: without this array the framework default holds seven entries (emergency,
     lockdown, power, restart, logout, screenshot, bugreport), which every image built on the plain base showed (RS30 lines, AURA 3 Max, MIRA 4K): only the
     Z9X 1.0.9 base carries an old Z9X copy. sync.sh copies this file into every framework RRO (item `power`);
     the press behaviours stay in each family's own config.xml. -->
<resources>
    <string-array name="config_globalActionsList" translatable="false">
        <item>power</item>
        <item>restart</item>
    </string-array>
</resources>
