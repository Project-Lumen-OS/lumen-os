    <color name="lumen_pkg_card">#FFDBD2C2</color>
    <color name="lumen_pkg_button">#0F211C13</color>
    <color name="lumen_pkg_button_focus">#FFE4DDD0</color>
    <color name="lumen_pkg_text1">#FF211C13</color>
    <color name="lumen_pkg_text2">#FF463F33</color>
    <color name="lumen_pkg_ring">#FF2F62D0</color>
    <color name="lumen_pkg_accent">#FF1D4AA3</color>
</resources>
