<?xml version="1.0" encoding="utf-8"?>
<!-- Shared styles of the overlay: android: attributes and the overlay's own resources. The installer's styles are
     overridden by name. The only installer ids used are the three guidance views (layout rules), through stub/. -->
<resources>
    <!-- framework alert dialogs of the install flow: a Lumen card (LumenPkg.DialogParent turns dark at night) -->
    <style name="LumenPkg.Dialog" parent="@style/LumenPkg.DialogParent">
        <item name="android:windowBackground">@drawable/lumen_pkg_card</item>
        <item name="android:windowMinWidthMajor">@dimen/lumen_pkg_dialog_width</item>
        <item name="android:windowMinWidthMinor">@dimen/lumen_pkg_dialog_width</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowElevation">0dp</item>
        <item name="android:colorBackground">@color/lumen_pkg_card</item>
        <item name="android:colorAccent">@color/lumen_pkg_accent</item>
        <item name="android:colorControlActivated">@color/lumen_pkg_ring</item>
        <item name="android:textColorPrimary">@color/lumen_pkg_text1</item>
        <item name="android:textColorSecondary">@color/lumen_pkg_text2</item>
        <item name="android:textColorAlertDialogListItem">@color/lumen_pkg_text1</item>
        <item name="android:fontFamily">@font/lumen_inter</item>
        <item name="android:dialogPreferredPadding">32dp</item>
        <item name="android:windowTitleStyle">@style/LumenPkg.DialogTitle</item>
        <item name="android:buttonBarStyle">@style/LumenPkg.ButtonBar</item>
        <item name="android:buttonBarButtonStyle">@style/LumenPkg.Button</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/LumenPkg.Button</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/LumenPkg.Button</item>
        <item name="android:buttonBarNeutralButtonStyle">@style/LumenPkg.Button</item>
    </style>

    <style name="LumenPkg.DialogTitle" parent="@android:style/TextAppearance.DeviceDefault.DialogWindowTitle">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/lumen_pkg_text1</item>
        <item name="android:fontFamily">@font/lumen_inter</item>
        <item name="android:fontVariationSettings">"'wght' 620"</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="LumenPkg.ButtonBar" parent="@android:style/Widget.Material.ButtonBar">
        <item name="android:paddingStart">26dp</item>
        <item name="android:paddingEnd">26dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">22dp</item>
    </style>

    <!-- pill button, 28 dp high (56 px), the ring 3 px outside a 3 px gap when focused -->
    <style name="LumenPkg.Button" parent="@android:style/Widget.DeviceDefault.Button.Borderless">
        <item name="android:background">@drawable/lumen_pkg_button</item>
        <item name="android:textColor">@color/lumen_pkg_text1</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/lumen_inter</item>
        <item name="android:fontVariationSettings">"'wght' 600"</item>
        <item name="android:minHeight">34dp</item>
        <item name="android:minWidth">100dp</item>
        <item name="android:paddingStart">23dp</item>
        <item name="android:paddingEnd">23dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:defaultFocusHighlightEnabled">false</item>
    </style>

    <!-- leanback guided step (uninstall confirm, "app not found" and other uninstall errors) -->
    <style name="Widget.Leanback.GuidanceContainerStyle" parent="@android:style/Widget">
        <item name="android:clipToPadding">false</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:paddingStart">48dp</item>
        <item name="android:paddingEnd">24dp</item>
    </style>

    <style name="Widget.Leanback.GuidanceIconStyle" parent="@android:style/Widget">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:layout_marginEnd">20dp</item>
        <item name="android:layout_alignParentStart">true</item>
    </style>

    <style name="Widget.Leanback.GuidanceBreadcrumbStyle" parent="@android:style/Widget">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/lumen_pkg_text2</item>
        <item name="android:fontFamily">@font/lumen_inter</item>
        <item name="android:ellipsize">end</item>
        <item name="android:gravity">start</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:singleLine">true</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:textAlignment">viewStart</item>
        <item name="android:layout_toEndOf">@*com.android.packageinstaller:id/guidance_icon</item>
    </style>

    <style name="Widget.Leanback.GuidanceTitleStyle" parent="@android:style/Widget">
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">@color/lumen_pkg_text1</item>
        <item name="android:fontFamily">@font/lumen_inter</item>
        <item name="android:fontVariationSettings">"'wght' 680"</item>
        <item name="android:ellipsize">end</item>
        <item name="android:gravity">start</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:maxLines">1</item>
        <item name="android:layout_below">@*com.android.packageinstaller:id/guidance_breadcrumb</item>
        <item name="android:layout_centerVertical">true</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:textAlignment">viewStart</item>
        <item name="android:layout_toEndOf">@*com.android.packageinstaller:id/guidance_icon</item>
    </style>

    <style name="Widget.Leanback.GuidanceDescriptionStyle" parent="@android:style/Widget">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/lumen_pkg_text2</item>
        <item name="android:fontFamily">@font/lumen_inter</item>
        <item name="android:ellipsize">end</item>
        <item name="android:gravity">start</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:maxLines">6</item>
        <item name="android:layout_below">@*com.android.packageinstaller:id/guidance_title</item>
        <item name="android:layout_alignWithParentIfMissing">true</item>
        <item name="android:lineSpacingExtra">4dp</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:textAlignment">viewStart</item>
        <item name="android:layout_toEndOf">@*com.android.packageinstaller:id/guidance_icon</item>
    </style>

    <style name="Widget.Leanback.GuidedActionItemContainerStyle" parent="@android:style/Widget">
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
        <item name="android:paddingStart">23dp</item>
        <item name="android:paddingEnd">23dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">false</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/lumen_pkg_button</item>
        <item name="android:defaultFocusHighlightEnabled">false</item>
    </style>

    <style name="Widget.Leanback.GuidedActionItemTitleStyle" parent="@android:style/Widget">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/lumen_pkg_text1</item>
        <item name="android:fontFamily">@font/lumen_inter</item>
        <item name="android:fontVariationSettings">"'wght' 600"</item>
        <item name="android:ellipsize">end</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:maxLines">1</item>
        <item name="android:textAlignment">viewStart</item>
    </style>
</resources>
