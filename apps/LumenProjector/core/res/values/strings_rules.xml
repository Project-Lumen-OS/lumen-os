<?xml version="1.0" encoding="utf-8"?>
<!-- Lumen OS 1.0.8 Z9X sweep (2026-11-04): notes of the stock refusal rules (panel/PanelRules) and two stock autofocus
     tips. Z9X only (not a shared file of apps/common/projector). Our own words with the stock meaning. English base;
     translations: gsi/apps/i18n/langs/<locale>.txt @projector/strings_rules.xml. Shown under the row title. -->
<resources>
    <!-- No Z9X row shows rules_not_ai any more (picture-rule-all): the picture settings pages say the stock texts
         of the shared lumen-menu PictureSettingsRule. It stays as the source of the shared vocabulary text
         lumen_not_available_in_the_ai_picture_mode (apps/core/lumen-common-strings/vocabulary.tsv), which every
         app with the vocabulary carries, so the other pinned Z9X APKs keep their bytes. -->
    <string name="rules_not_ai">@string/lumen_not_available_in_the_ai_picture_mode</string>
    <string name="rules_not_performance">@string/lumen_not_available_in_the_performance_mode</string>
    <string name="rules_not_office">@string/lumen_not_available_in_the_office_mode</string>
    <string name="rules_not_top_speed">Not available in the top-speed game mode</string>
    <string name="rules_not_boost">@string/lumen_not_available_at_the_boost_brightness_level</string>
    <string name="rules_not_ultra120">Not available while Ultra 120 Hz is on</string>
    <string name="rules_not_native_fps">Not available while Original frame rate is on</string>
    <string name="rules_not_hdr">Not available with HDR video</string>
    <string name="rules_not_hfr">Not available at a high frame rate</string>
    <string name="rules_close_hfr">Turn off the high frame rate and try again</string>
    <string name="rules_dv_active">The Dolby Vision picture mode is in use</string>
    <!-- Brightness note, the %1$s of panel_lamp_mode_locked when the lumens mode is Custom (IGmpf 175 = 6). -->
    <string name="rules_custom">@string/lumen_custom_2</string>
    <!-- Autofocus could not start (vendor event 7). -->
    <string name="af_init_failed">Autofocus could not start</string>
    <!-- After autofocus, when fine-tuning is offered (vendor event 18 AF_Success_Into_Adjust). -->
    <string name="af_done_fine_tune">Focus done. Hold the focus button to fine-tune it.</string>
</resources>
