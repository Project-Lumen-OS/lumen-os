<?xml version="1.0" encoding="utf-8"?>
<!-- Test only (never in an image): one text field that opens the keyboard, for the emulator renders of test/render.sh -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.lumen.kbpreview">
    <uses-feature android:name="android.software.leanback" android:required="false"/>
    <uses-feature android:name="android.hardware.touchscreen" android:required="false"/>
    <application android:label="Keyboard preview" android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
        <activity android:name=".Field" android:exported="true" android:windowSoftInputMode="stateAlwaysVisible">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
                <category android:name="android.intent.category.LEANBACK_LAUNCHER"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
