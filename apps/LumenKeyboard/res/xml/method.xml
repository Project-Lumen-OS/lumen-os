<!-- Lumen: one subtype per org.lumen.keyboard.KeyboardLanguage (same order, locale and subtypeId; test/run.sh).
     The Latin one is enabled by the system next to a non-Latin system language even before the keyboard's own
     first start rule ran (EnabledWhenDefaultIsNotAsciiCapable). -->
<input-method xmlns:android="http://schemas.android.com/apk/res/android"
    android:isDefault="@bool/im_is_default"
    android:settingsActivity="org.lumen.keyboard.LanguagesActivity"
    android:supportsSwitchingToNextInputMethod="true">
    <subtype android:label="@string/subtype_generic"
            android:subtypeId="0x4c4b0001"
            android:imeSubtypeLocale="en_US"
            android:imeSubtypeMode="keyboard"
            android:isAsciiCapable="true"
            android:imeSubtypeExtraValue="AsciiCapable,EnabledWhenDefaultIsNotAsciiCapable"
    />
    <subtype android:label="@string/subtype_generic"
            android:subtypeId="0x4c4b0002"
            android:imeSubtypeLocale="ru_RU"
            android:imeSubtypeMode="keyboard"
            android:isAsciiCapable="false"
    />
    <subtype android:label="@string/subtype_generic"
            android:subtypeId="0x4c4b0003"
            android:imeSubtypeLocale="uk_UA"
            android:imeSubtypeMode="keyboard"
            android:isAsciiCapable="false"
    />
    <subtype android:label="@string/subtype_generic"
            android:subtypeId="0x4c4b0004"
            android:imeSubtypeLocale="be_BY"
            android:imeSubtypeMode="keyboard"
            android:isAsciiCapable="false"
    />
    <subtype android:label="@string/subtype_generic"
            android:subtypeId="0x4c4b0005"
            android:imeSubtypeLocale="kk_KZ"
            android:imeSubtypeMode="keyboard"
            android:isAsciiCapable="false"
    />
    <subtype android:label="@string/subtype_generic"
            android:subtypeId="0x4c4b0006"
            android:imeSubtypeLocale="ar"
            android:imeSubtypeMode="keyboard"
            android:isAsciiCapable="false"
    />
</input-method>
