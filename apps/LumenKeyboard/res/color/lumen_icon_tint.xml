<?xml version="1.0" encoding="utf-8"?>
<!-- The default tint of the lumen_ic_* icons (apps/core/lumen-icons): white on a focused row, the row's text colour
     otherwise. The languages screen sets its own tints on the switch. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="#FFFFFFFF" android:state_focused="true" />
    <item android:color="#FFF1F3F4" />
</selector>
